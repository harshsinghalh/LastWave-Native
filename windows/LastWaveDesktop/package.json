{
  "name": "lastwave-desktop",
  "version": "4.5.0",
  "description": "LastWave Windows 11 client with Android UI parity",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "test:smoke": "node tests/smoke.mjs",
    "dist": "electron-builder --win nsis --x64",
    "test:parity": "node tests/parity-smoke.mjs"
  },
  "dependencies": {
    "youtubei.js": "18.1.0",
    "bgutils-js": "4.0.3",
    "jsdom": "30.1.1"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.lastwave.desktop",
    "productName": "LastWave",
    "artifactName": "LastWave-Setup-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.mjs",
      "preload.mjs",
      "services/**/*",
      "renderer/**/*",
      "resources/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../../lastwave_logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LastWave"
    }
  }
}
