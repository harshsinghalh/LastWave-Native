-        root.deleteDir()
-        def target = new File(root, 'art-profile')
-        target.mkdirs()
-
-        def profgenFile = new File(profgen.get())
-        def hrf = humanReadableProfile.files.find { it.isFile() }
-        def dexes = dexFiles.files.findAll { it.isFile() && it.name ==~ /classes\d*\.dex/ }
-        if (!profgenFile.canExecute() || hrf == null || dexes.isEmpty()) {
-            logger.warn("NewTube: no embedded ART profile (profgen=${profgenFile.canExecute()}, " +
-                    "profile=${hrf != null}, dex=${dexes.size()}); install-time compilation stays off")
-            return
-        }
-
-        // profgen resolves rules against classes*.dex inside an APK-shaped zip.
-        def dexZip = new File(temporaryDir, 'dex.zip')
-        new java.util.zip.ZipOutputStream(new FileOutputStream(dexZip)).withCloseable { zip ->
-            dexes.sort { it.name }.each { dex ->
-                zip.putNextEntry(new java.util.zip.ZipEntry(dex.name))
-                dex.withInputStream { zip << it }
-                zip.closeEntry()
-            }
-        }
-
-        execOperations.exec {
-            commandLine profgenFile.absolutePath, 'bin', hrf.absolutePath,
-                    '--apk', dexZip.absolutePath,
-                    '--output', new File(target, 'baseline.prof').absolutePath,
-                    '--profile-format', 'v0_1_5_s'
-        }
-    }
-}
